{
  "name": "lianban-decision-desk",
  "productName": "连板决策台",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "连板决策台 · Windows 桌面版与安卓版（本地运行，无需服务器）",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:web": "vite build",
    "test:runtime": "tsx scripts/test-runtime.ts",
    "electron:dev": "npm run build:web && electron .",
    "electron:build": "npm run build:web && electron-builder --win nsis --publish never",
    "android:sync": "npm run build:web && cap sync android",
    "gen:migration": "drizzle-kit generate --dialect sqlite --schema server/schema.ts --out drizzle && node scripts/gen-migrations.mjs",
    "android:apk": "npm run android:sync && cd android && gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@tanstack/react-query": "5.100.10",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "2.15.3",
    "sql.js": "^1.12.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@tailwindcss/vite": "4.1.13",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "fake-indexeddb": "^6.2.6",
    "iconv-lite": "^0.7.3",
    "jsdom": "^30.1.3",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "tsx": "^4.19.0",
    "typescript": "5.6.3",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.motoke.lianban",
    "productName": "连板决策台",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "连板决策台",
      "artifactName": "LianbanDecisionDesk-Setup-${version}.exe"
    },
    "publish": null
  },
  "author": "Motoke"
}
