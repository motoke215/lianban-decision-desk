{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@hatch/space-sdk": ["runtime/sdk.ts"],
      "@hatch/space-sdk/client": ["runtime/client.ts"],
      "@space/privileged": ["runtime/contracts.ts"]
    }
  },
  "include": ["src", "server", "runtime", "collector", "scripts", "vite.config.ts"],
  "exclude": ["runtime/privileged.orig.ts"]
}
